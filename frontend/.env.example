# Optional. Origin used to prefix every /api/... call from the frontend.
# Leave empty in dev to use the Vite proxy (which forwards /api -> http://localhost:8000
# and strips the /api prefix).
# Set to e.g. https://api.example.com when the frontend is served from a different
# origin (Phase 23 Docker split, reverse proxy without an /api strip, CDN host).
VITE_API_BASE_URL=

# Optional. Set to "false" to hide the "Download as Word" option in the
# shared <ReportDownloadButton>. Defaults to enabled. Useful only if a
# deployment can't run the Playwright-based DOCX export (the same path
# already used by the PDF export).
VITE_REPORT_DOCX_ENABLED=
