# OpenLIA environment configuration
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# The server CLI loads `.env` (then `.env.local` as an overlay) at startup via
# python-dotenv; every value below is read from the process environment.

# Deployment mode: "personal" (single user, no auth) or "company" (multi-user, auth enabled)
OPENLIA_MODE=personal

# Secret key used to encrypt connector secrets at rest. This is a Fernet key:
# a urlsafe-base64-encoded 32-byte value (Fernet = AES-128-CBC + HMAC-SHA256).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset in personal mode, the server auto-generates one and writes it to
# ~/.openlia/secret.key (chmod 600) on first run. Required in company mode.
# OPENLIA_SECRET_KEY=

# Data home directory. Holds the SQLite DB, secret.key, attachments, report
# bundles, skills, etc. Default: ~/.openlia
# OPENLIA_HOME=

# Database URL. If unset, defaults to a SQLite file under OPENLIA_HOME (openlia.db).
# The server expands `~` at startup before passing to SQLAlchemy.
# OPENLIA_DB_URL=

# Server bind address. Defaults: 127.0.0.1 in personal, 0.0.0.0 in company.
# OPENLIA_HOST=127.0.0.1

# Server bind port. Default: 8000.
# OPENLIA_PORT=8000

# ---------------------------------------------------------------------------
# Frontend serving
# ---------------------------------------------------------------------------
# Absolute path to the built SPA (frontend/dist). When set (or found at
# /app/frontend/dist in the Docker image, or <repo>/frontend/dist for a local
# npm build), the server mounts the UI. With no dist available the server runs
# API-only (JSON), which is the default for a bare `pip install openlia`.
# OPENLIA_FRONTEND_DIST=

# ---------------------------------------------------------------------------
# Company-mode auth / onboarding
# ---------------------------------------------------------------------------
# Cookie Secure attribute. Defaults to true when OPENLIA_MODE=company, false
# otherwise. Set explicitly to override (e.g. local company-mode over HTTP).
# OPENLIA_COOKIE_SECURE=true

# Minimum password length enforced on registration / password change. Default 8.
# OPENLIA_PASSWORD_MIN_LENGTH=8

# The following are written by the setup wizard and read back as read-only
# env-precedence overrides; set them to pin wizard-managed startup config.
# OPENLIA_AUTH_ENABLED=            # "true"/"false"; overrides mode-derived auth
# OPENLIA_BIND_HOST=               # overrides OPENLIA_HOST for the bind step
# OPENLIA_BIND_PORT=               # overrides OPENLIA_PORT for the bind step
# OPENLIA_SIGNUP_POLICY=           # invite-only | open | closed
# OPENLIA_SIGNUP_ALLOWED_DOMAINS=  # comma-separated email domains for open signup

# ---------------------------------------------------------------------------
# LLM provider API keys
# ---------------------------------------------------------------------------
# Connectors configured in the UI store their own secrets (encrypted at rest).
# These env vars are process-wide fallbacks the runtime reads when a provider
# key is not configured through a connector. Set whichever providers you use.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Market-data / connector provider keys
# ---------------------------------------------------------------------------
# Env fallbacks used by the built-in connector templates when no matching
# connector row supplies the secret. Each is optional; set only what you use.
# EODHD_API_KEY=            # EODHD (fundamentals, prices, calendars)
# FMP_API_KEY=              # Financial Modeling Prep connector
# FIRECRAWL_API_KEY=        # Firecrawl web-scraping connector
# NEWSAPI_AI_API_KEY=       # NewsAPI.ai (Event Registry) news connector
# X_API_BEARER_TOKEN=       # X / Twitter API bearer token (Retail Sentiment)

# ---------------------------------------------------------------------------
# Web search
# ---------------------------------------------------------------------------
# Native provider web search is on by default. Emergency kill switch and flag:
# OPENLIA_DISABLE_NATIVE_WEB_SEARCH=false   # "true" force-disables native search
# OPENLIA_NATIVE_WEB_SEARCH=true            # migration flag; default true

# ---------------------------------------------------------------------------
# Deployment / reverse-proxy
# ---------------------------------------------------------------------------
# Trust X-Forwarded-* headers from a reverse proxy (e.g. Cloudflare Tunnel,
# nginx). Required when running behind a proxy so loopback/host detection and
# secure-cookie logic see the real client. Leave unset for direct exposure.
# OPENLIA_TRUST_PROXY_HEADERS=true

# Public-facing base URL, used to build absolute links in reports/emails.
# OPENLIA_PUBLIC_URL=https://openlia.example.com

# Internal base URL the server calls itself on (report render, etc).
# Default http://127.0.0.1:8000.
# OPENLIA_SERVER_URL=

# Base URL used when rendering reports to HTML/PDF (Playwright). Falls back to
# the server URL when unset.
# OPENLIA_REPORT_RENDER_BASE_URL=

# ---------------------------------------------------------------------------
# On-disk artifact locations (all default under OPENLIA_HOME)
# ---------------------------------------------------------------------------
# OPENLIA_ATTACHMENTS_DIR=   # chat attachment storage
# OPENLIA_REPORT_BUNDLE_DIR= # generated report bundles
# OPENLIA_SKILLS_ROOT=       # filesystem skill store root

# ---------------------------------------------------------------------------
# Background scheduler (Morning Briefing, Earnings calendar, maintenance jobs)
# ---------------------------------------------------------------------------
# Enable the in-process APScheduler. Default: enabled. Set to false to run a
# pure request/response instance (e.g. a second replica that should not run jobs).
# OPENLIA_SCHEDULER_ENABLED=true
# Max simultaneous scheduled jobs. Default 5.
# OPENLIA_SCHEDULER_MAX_CONCURRENT_JOBS=5
# APScheduler misfire grace window in seconds.
# OPENLIA_SCHEDULER_MISFIRE_GRACE_SECONDS=
# Grace period to let in-flight jobs finish on shutdown, in seconds.
# OPENLIA_SCHEDULER_SHUTDOWN_GRACE_SECONDS=

# ---------------------------------------------------------------------------
# Data retention (nightly maintenance sweep)
# ---------------------------------------------------------------------------
# Days before an unsaved (no repo pointer) report is tombstoned. Default 7.
# OPENLIA_UNSAVED_REPORT_RETENTION_DAYS=7
# Days to keep Lia guardrail-event audit rows. Default per code constant.
# LIA_GUARDRAIL_LOG_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# Report / engine runtime tuning (optional; sane defaults baked in)
# ---------------------------------------------------------------------------
# v3 equity-research runner caps:
# REPORT_V3_TOOL_TIMEOUT_SECONDS=120       # per-tool-call wall cap (seconds)
# REPORT_V3_MAX_TURNS=                      # max LLM turns per run
# REPORT_V3_MAX_WALL_TIME_SECONDS=          # total wall-clock cap per run
# Per-call wall cap for connector tool dispatch off the event loop (seconds).
# Bounds no-timeout SDKs (e.g. EODHD) so a hung endpoint can't freeze the loop.
# Default 120.
# OPENLIA_CONNECTOR_TOOL_TIMEOUT_SECONDS=120
# Max tools exposed to the model per request.
# OPENLIA_MAX_TOOLS_PER_REQUEST=
# Max writing turns for report generation.
# OPENLIA_MAX_WRITING_TURNS=
# Tool-result payload handling thresholds (characters):
# OPENLIA_PAYLOAD_STUB_THRESHOLD_CHARS=
# OPENLIA_READ_PAYLOAD_CAP_CHARS=

# Feature flags (default off, "1" to enable):
# OPENLIA_BACKGROUND_REPORTS_ENABLED=0
# OPENLIA_REVISION_PASS_ENABLED=0
# OPENLIA_REPORT_CHAT_ENABLED=0
# OPENLIA_USE_SUBAGENT_RUNNER=0            # equity_research only
# OPENLIA_DEFAULT_SUBAGENT_MODEL_ID=       # model id for the subagent runner

# Batch / async run tuning:
# OPENLIA_BATCH_MAX_WAIT_HOURS=
# OPENLIA_BATCH_POLL_INTERVAL_SECONDS=
# OPENLIA_AUTO_CANCEL_GRACE_SECONDS=
# OPENLIA_AUTO_CANCEL_POLL_SECONDS=

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# OPENLIA_DEV_MODE=          # enable dev-only routes/behavior
# OPENLIA_DEV_EVENTS_LOG=    # path to write raw runtime event log for debugging
