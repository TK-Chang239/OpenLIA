# v2.3 smoke-test environment template.
#
# 1. Copy this file:    cp scripts/smoke_v2_3.env.example scripts/smoke_v2_3.env
# 2. Paste your keys + pick models below.
# 3. Run:               scripts/smoke_v2_3.sh
#
# scripts/smoke_v2_3.env is gitignored — keys never leave your machine.

# ---------------------------------------------------------------------------
# Required: OpenAI API key. Use the same key as your root .env if you like.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional: data providers. RESEARCH falls back to web-only tools if unset.
# ---------------------------------------------------------------------------
# EODHD_API_KEY=
# FMP_API_KEY=

# ---------------------------------------------------------------------------
# Per-stage model assignments. Only CLARIFY is strictly required.
# Unset stages NoOp (the run still completes; the .docx is just thinner).
# ---------------------------------------------------------------------------
OPENLIA_V2_3_CLARIFY_MODEL=gpt-4.1-mini

# Uncomment the rows below to exercise the full pipeline.
# Mini-tier picks save cost; full-tier picks give better prose.
# OPENLIA_V2_3_PLAN_MODEL=gpt-4.1-mini
# OPENLIA_V2_3_RESEARCH_MODEL=gpt-4.1
# OPENLIA_V2_3_COMPUTE_MODEL=gpt-4.1-mini
# OPENLIA_V2_3_SYNTHESIZE_MODEL=gpt-4.1
# OPENLIA_V2_3_WRITE_MODEL=gpt-4.1
# OPENLIA_V2_3_VERIFY_MODEL=gpt-4.1-mini

# Optional per-stage budgets. Bump RESEARCH if the model truncates
# the final JSON (more facts / larger time series = more tokens).
# OPENLIA_V2_3_RESEARCH_MAX_TOKENS=16384

# ---------------------------------------------------------------------------
# Smoke-run parameters. Tweak the prompt + ticker as you like.
# ---------------------------------------------------------------------------
SMOKE_TICKER=NVDA
SMOKE_REPORT_TYPE=initiation
SMOKE_LANGUAGE=en
SMOKE_PROMPT="Write a 12-month initiation report on NVDA for a PM. Include a DCF and competitive overview."

# Where to write the rendered .docx. Leave blank to skip rendering.
SMOKE_OUTPUT=/tmp/v2_3_smoke.docx
