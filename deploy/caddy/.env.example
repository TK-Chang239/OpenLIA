# OpenLIA — Caddy reverse-proxy deployment
# Copy to `.env` and fill in real values before `docker compose up -d`.

# Container image. Pick a pinned tag for production (e.g. `:0.1.0`).
OPENLIA_IMAGE=ghcr.io/TK-Chang239/openlia:latest

# Base64-encoded 32-byte AES-256-GCM key. Generate with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
OPENLIA_SECRET_KEY=

# Public FQDN with DNS A/AAAA record pointing at this host. Required for
# automatic Let's Encrypt certificate provisioning.
OPENLIA_HOSTNAME=lia.example.com
