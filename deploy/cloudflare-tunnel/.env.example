# OpenLIA — Cloudflare Tunnel deployment
# Copy to `.env` and fill in real values before `docker compose up -d`.

# Container image. Pick a pinned tag for production (e.g. `:0.1.0`).
OPENLIA_IMAGE=ghcr.io/TK-Chang239/openlia:latest

# Base64-encoded 32-byte AES-256-GCM key. Generate with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
OPENLIA_SECRET_KEY=

# Cloudflare Zero Trust tunnel token. Create the tunnel in the dashboard
# (Zero Trust > Networks > Tunnels) and paste the connector token here.
TUNNEL_TOKEN=

# Public HTTPS URL users reach this deployment at. Must match the Cloudflare
# public hostname route. Used to build correct invite links.
OPENLIA_PUBLIC_URL=https://lia.example.com
